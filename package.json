{
  "name": "pixclean-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PixelClean Studio Desktop — application standalone Electron pour le nettoyage de mixels et de palettes pixel art.",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "npm run build:electron && concurrently -k -n vite,electron \"vite --strictPort --port 5173\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev": "npm run dev:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/write-electron-pkg.mjs",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "dot-stash": "https://github.com/jezoock/dot-stash/releases/download/v0.2.0/dot-stash-0.2.0.tgz",
    "pixclean": "https://github.com/jezoock/pixClean/releases/download/v1.0.0/pixclean-1.0.0.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.1.5",
    "electron-builder": "^25.1.8",
    "typescript": "~5.8.3",
    "vite": "^6.2.0",
    "wait-on": "^8.0.3"
  }
}
